# Production .env for the CMS (cms.ameersconstruction.com).
# On the server:  cp .env.production.example .env   then fill in every line marked  <<< CHANGE
# Never commit the real .env. docker-compose.yml mounts it into the container read-only.
#
# Do not use ${OTHER_VAR} references and avoid spaces around "=".
# Wrap any value that contains spaces or # or $ in double quotes.

APP_NAME="Ameer's CMS"
APP_ENV=production
APP_DEBUG=false
# Generate one on the server with:  echo "base64:$(openssl rand -base64 32)"
# Paste the whole output, including the "base64:" part. Keep it forever: changing it logs everyone out
# and makes encrypted data (like two-factor secrets) unreadable.
APP_KEY=                                   # <<< CHANGE
APP_URL=https://cms.ameersconstruction.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Logs go to `docker compose logs` instead of files
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# SQLite, stored in the cms_storage volume (survives rebuilds). Back this file up.
# For MySQL instead: DB_CONNECTION=mysql, DB_HOST=host.docker.internal (or the DB host), DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/database/database.sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Leave unset/null: the cookie is only used on cms.ameersconstruction.com
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---- Mail: the "new contact request" email to the office -------------------------------------------
# The recipients are set in the CMS under Site settings > notification emails.
# Use your real SMTP provider (Google Workspace, Microsoft 365, Brevo, Postmark, Resend SMTP, ...).
MAIL_MAILER=smtp
MAIL_SCHEME=null                           # use "smtps" only for port 465; null for 587 (STARTTLS)
MAIL_HOST=smtp.example.com                 # <<< CHANGE
MAIL_PORT=587                              # <<< CHANGE
MAIL_USERNAME=                             # <<< CHANGE
MAIL_PASSWORD=                             # <<< CHANGE
MAIL_FROM_ADDRESS=no-reply@ameersconstruction.com   # <<< CHANGE: must be an address your SMTP account may send from
MAIL_FROM_NAME="Ameer's Construction"

# ---- CMS --------------------------------------------------------------------------------------------
# Where uploads live. "public" = the cms_storage volume, served at https://cms.ameersconstruction.com/storage
# Switch to "s3" later for a bucket/CDN (then also fill the AWS_* lines).
CMS_MEDIA_DISK=public

# The website. After every save the CMS calls POST {FRONTEND_URL}/api/revalidate with the secret below.
FRONTEND_URL=https://ameersconstruction.com
# Make one with:  openssl rand -hex 32     The website's REVALIDATE_SECRET must be the exact same value.
FRONTEND_REVALIDATE_SECRET=                # <<< CHANGE

# Cloudflare Turnstile SECRET key (dash.cloudflare.com > Turnstile). The contact form is refused while this is empty.
# The matching public SITE key goes in the website's NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=                      # <<< CHANGE

# Reverse proxies whose X-Forwarded-* headers are trusted (nginx on the host reaches the container from the Docker network).
# This makes Laravel see https, so links and login cookies are built correctly.
TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1

# ---- Only if CMS_MEDIA_DISK=s3 ----------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="Ameer's CMS"
